# =============================================================================
# Solana Arbitrage Bot — Configuration
# Copy to .env and fill ALL required values before starting.
# =============================================================================

# --- Required ---
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
KEYPAIR_PATH=./wallet.json
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Trading parameters ---
TRADE_AMOUNT_SOL=0.05
MIN_PROFIT_PCT=0.1
MAX_SLIPPAGE_PCT=0.5
KILL_SWITCH_SOL=0.05
POLL_INTERVAL_SEC=3
EXECUTOR_PATH=./executor/target/release/executor

# --- Safety gates ---
# DRY_RUN=true means no real transactions. Default: true.
DRY_RUN=true
# TRADING_ENABLED must be explicitly 'true' to allow live execution.
# Bot will REFUSE to start if DRY_RUN=false and TRADING_ENABLED is not 'true'.
TRADING_ENABLED=false
# Block routes not fully supported (e.g. Orca execution, triangular arb).
LIVE_TRADING_ALLOW_UNSUPPORTED_ROUTES=false
# Use Jito bundles for atomic 2-leg execution (default: true).
# If false, legs execute as separate transactions (MEV risk).
USE_JITO_BUNDLES=true
JITO_TIP_LAMPORTS=50000

# --- Network bind (127.0.0.1 = internal only, 0.0.0.0 = public) ---
HEALTH_BIND_HOST=127.0.0.1
DASHBOARD_BIND_HOST=127.0.0.1

# --- Dashboard (strong credentials REQUIRED — weak ones will be rejected) ---
DASHBOARD_USER=your_dashboard_username
DASHBOARD_PASS=your_strong_password_here

# --- Database (no default — leave empty to disable persistence) ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- AI (optional) ---
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LOG_PATH=/var/log/arb-bot/bot.log
