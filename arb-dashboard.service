[Unit]
Description=Solana Arb Bot — Dashboard
After=arb-bot.service

[Service]
Type=simple
User=arbbot
Group=arbbot
WorkingDirectory=/opt/solana-arb-bot
EnvironmentFile=/opt/solana-arb-bot/.env
ExecStart=/opt/solana-arb-bot/venv/bin/python dashboard/app.py
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=append:/var/log/arb-bot/dashboard.log
StandardError=append:/var/log/arb-bot/dashboard-error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/arb-bot /opt/solana-arb-bot
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
